{
  "name": "dsh-computer-history",
  "version": "0.1.0-dev.0",
  "description": "Privacy-first work continuity for DeepSeek Harness: metadata-only computer history, deterministic work episodes, and selective resume context.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsdown && node -e \"const fs=require('node:fs');fs.renameSync('lib/.client-dts/client.d.ts','lib/client.d.ts');fs.rmSync('lib/.client-dts',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "native:build": "node scripts/build-native.mjs",
    "native:test": "node scripts/test-native.mjs",
    "verify:privacy": "node scripts/verify-privacy-boundary.mjs",
    "verify": "pnpm check && pnpm verify:privacy && pnpm verify:adapters && pnpm verify:store-protection && pnpm verify:semantic-boundary && pnpm verify:architecture && pnpm verify:migrations && pnpm verify:native-timeouts && pnpm verify:docs && pnpm verify:collector-windows",
    "verify:p1": "pnpm verify && pnpm build && pnpm benchmark:ingestion && pnpm native:build && pnpm native:test",
    "prepack": "pnpm build && pnpm native:build",
    "benchmark:ingestion": "vitest run --config vitest.benchmark.config.ts",
    "verify:tools": "node scripts/verify/build-tools.mjs",
    "verify:adapters": "node scripts/verify-adapters.mjs",
    "verify:store-protection": "node scripts/verify-store-protection.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "verify:semantic-boundary": "node scripts/verify-semantic-boundary.mjs",
    "build:editor-extension": "pnpm exec tsc -p extension-editor && cd extension-editor && node node_modules/@vscode/vsce/vsce package --no-dependencies --allow-missing-repository --skip-license -o ../dsh-computer-history-editor.vsix",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:native-timeouts": "node scripts/verify-native-timeouts.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:collector-windows": "node scripts/verify-collector-windows.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.12",
    "@vitest/coverage-v8": "^4.1.8",
    "fast-check": "^4.8.0",
    "oxlint": "1.76.0",
    "react": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "bin/dsh-computer-history-collector",
    "native/macos/Sources",
    "native/macos/Package.swift",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "SECURITY.md",
    "scripts/build-native.mjs",
    "scripts/test-native.mjs",
    "presets",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
