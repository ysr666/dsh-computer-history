# Dependencies
node_modules/

# Build outputs
lib/
dist/
coverage/
*.tsbuildinfo

# Native / Swift
native/**/.build/
native/**/.swiftpm/
native/**/Package.resolved
bin/

# Local runtime data
.data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Logs and debug artifacts
.debug/
debug/
*.log
npm-debug.log*
pnpm-debug.log*
# Tool-run artifacts (e.g. vision router screenshots) are not project files
.dsh-vision-router/

# Bench / live local captures
tests/benchmark/field/private/
tests/live/output/
*.ndjson

# Environment / credentials
.env
.env.*
!.env.example
*.pem
*.key

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Temporary packaging
tmp/
tmp-pack/
*.tgz
extension-editor/out/
*.vsix

# Gradle and IntelliJ Platform build output: every file under these directories is generated on the
# machine that ran the build (caches, locks, local platform descriptors), so a clone must not carry them.
# They are listed here rather than in a per-project file because the next Gradle project in this repo
# would otherwise repeat the same mistake.
.gradle/
.intellijPlatform/
.kotlin/
build/
